{
  "name": "centralpdf-admin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:catalog && tsc --noEmit && vite build",
    "test": "vitest run",
    "types": "wrangler types",
    "dev:worker": "wrangler dev",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "sync:catalog": "node ../scripts/sync-admin-catalog.mjs",
    "check:catalog": "node ../scripts/sync-admin-catalog.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
